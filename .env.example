PORT=5059
# Public URL the Tool Hub uses to reach this tool (ngrok or Cloudflare tunnel)
TOOL_URL=https://your-tunnel.ngrok-free.app

# Calendar API key from luma.com/calendar/manage/api-keys (needs Luma Plus). Keep it secret: it controls the calendar.
LUMA_API_KEY=

# Tool Hub address, and the secret registered for this tool, used to post new events without being asked
HUB_URL=https://your-tool-hub.example
LUMA_TOOL_SECRET=make-up-a-long-random-string

# How often to check the calendar, and which event visibilities get shared (comma separated)
LUMA_POLL_MINUTES=10
LUMA_VISIBILITY=public

# Optional: if Luma webhooks are set to POST to TOOL_URL/luma/webhook?token=..., require this token
LUMA_WEBHOOK_TOKEN=
